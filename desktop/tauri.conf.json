{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlockCorn",
  "version": "0.1.0",
  "identifier": "com.blockcorn.app",
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "BlockCorn — Настройки",
        "width": 600,
        "height": 480,
        "visible": false,
        "closable": true,
        "resizable": false,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "tray",
      "iconPath": "icons/tray.png",
      "title": "BlockCorn",
      "tooltip": "BlockCorn — фильтр контента"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon32.png",
      "icons/icon128.png"
    ],
    "resources": ["icons/*"],
    "windows": {
      "wix": {},
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
